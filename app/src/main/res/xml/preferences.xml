<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_general">
        <!-- Not persisted here: the source of truth is AppCompatDelegate's app locale. -->
        <ListPreference
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:iconSpaceReserved="false"
            app:key="app_language"
            app:persistent="false"
            app:title="@string/pref_language_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_protection">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="protection_enabled"
            app:summary="@string/pref_protection_summary"
            app:title="@string/pref_protection_title" />
        <ListPreference
            app:entries="@array/preventive_mode_entries"
            app:entryValues="@array/preventive_mode_values"
            app:iconSpaceReserved="false"
            app:key="preventive_mode"
            app:title="@string/pref_preventive_title"
            app:useSimpleSummaryProvider="true" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="car_link"
            app:title="@string/pref_car_link_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_diagnostics">
        <SwitchPreferenceCompat app:singleLineTitle="false" app:key="idle_auto" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="@string/idle_auto_title" app:summary="@string/idle_auto_body" />
        <SwitchPreferenceCompat app:singleLineTitle="false" app:key="idle_voice" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="@string/idle_voice_title" app:summary="@string/idle_voice_body" />
        <SwitchPreferenceCompat app:singleLineTitle="false" app:key="idle_duplex" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="@string/duplex_title" app:summary="@string/duplex_summary" />
        <Preference app:key="recovery_help" app:iconSpaceReserved="false"
            app:title="@string/recovery_help_title" app:summary="@string/recovery_help_summary" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="share_report"
            app:summary="@string/pref_share_summary"
            app:title="@string/pref_share_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="clear_history"
            app:title="@string/pref_clear_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_updates">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:iconSpaceReserved="false"
            app:key="auto_update_check"
            app:title="@string/pref_auto_update_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="check_update"
            app:title="@string/pref_check_update_title" />
    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/pref_category_about">
        <Preference
            app:iconSpaceReserved="false"
            app:key="about_version"
            app:title="@string/pref_version_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="about_device"
            app:title="@string/pref_device_title" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="about_project"
            app:summary="@string/project_url"
            app:title="@string/pref_project_title" />
    </PreferenceCategory>
</PreferenceScreen>
