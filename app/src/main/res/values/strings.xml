    <!-- Status hero -->
    <string name="status_active_title">Schutz aktiv</string>
    <string name="status_active_body">Die App arbeitet unsichtbar während deiner Anrufe und behebt Audiofehler automatisch. Du musst nichts tun – auch nicht während der Fahrt.</string>
    <string name="status_bluetooth_off_body">Bluetooth ist gerade aus. Sobald du über Fahrzeug oder Headset telefonierst, ist der Schutz automatisch dabei.</string>
    <string name="status_setup_title">Einrichtung abschließen</string>
    <string name="status_setup_body">Noch ein oder zwei einmalige Schritte, dann arbeitet der Schutz vollautomatisch.</string>
    <string name="status_paused_title">Schutz pausiert</string>
    <string name="status_paused_body">Die automatische Reparatur ist in den Einstellungen ausgeschaltet. Anrufe werden nur protokolliert.</string>
    <string name="status_reboot_title">Neustart empfohlen</string>
    <string name="status_reboot_body">Beim letzten Anruf war die Bluetooth-Telefonie im System blockiert. Das kann keine App beheben – ein Neustart des Telefons stellt sie wieder her.</string>
    <string name="status_last_active">Zuletzt aktiv: %1$s</string>
    <string name="status_never_active">Noch kein Anruf seit der Einrichtung</string>

    <!-- Setup -->
    <string name="setup_title">Einrichtung</string>
    <string name="setup_bluetooth_title">Bluetooth-Zugriff</string>
    <string name="setup_bluetooth_body">Damit die App erkennt, ob Fahrzeug oder Headset verbunden sind.</string>
    <string name="setup_bluetooth_action">Erlauben</string>
    <string name="setup_call_title">Anruf-Audio steuern</string>
    <string name="setup_call_body">Verknüpfe einmalig dein Fahrzeug. Dann startet Android die App nur während Anrufen und sie darf die Audio-Ausgabe umschalten – wie die Audio-Taste in der Telefon-App.</string>
    <string name="setup_call_action">Fahrzeug verknüpfen</string>
    <string name="setup_call_adb">Alternative per ADB</string>
    <string name="setup_done">Erledigt</string>
    <string name="setup_choose_device">Fahrzeug oder Headset wählen</string>
    <string name="setup_no_devices">Keine gekoppelten Bluetooth-Geräte gefunden. Kopple zuerst dein Fahrzeug in den Bluetooth-Einstellungen.</string>
    <string name="setup_link_hint_title">Hinweis zum Systemdialog</string>
    <string name="setup_link_hint_body">Android zeigt gleich einen Bestätigungsdialog an. Er bezeichnet das Fahrzeug als „Uhr“ und listet mögliche Berechtigungen auf. Das ist technisch bedingt: Nur diese Geräteart erlaubt Apps, das Anruf-Audio zu steuern. Die App fordert keine weiteren Berechtigungen an und sendet keine Daten.</string>
    <string name="setup_link_continue">Weiter</string>
    <string name="setup_linked">%1$s verknüpft</string>
    <string name="setup_link_failed">Verknüpfung fehlgeschlagen: %1$s</string>
    <string name="setup_adb_title">Einrichtung per ADB</string>
    <string name="setup_adb_body">Falls der Systemdialog auf deinem Gerät nicht funktioniert: USB- oder WLAN-Debugging aktivieren und am Computer einmalig diesen Befehl ausführen. Die Freigabe bleibt auch nach Neustarts bestehen.</string>
    <string name="setup_adb_copy">Befehl kopieren</string>
    <string name="setup_adb_copied">Befehl kopiert</string>
    <string name="action_cancel">Abbrechen</string>
    <string name="action_close">Schließen</string>

